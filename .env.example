# ChromaDB
CHROMA_DB_PATH=/path/to/your/tck_chromadb
COLLECTION_NAME=tck_koleksiyonu_e5

# Data sources (Phase 2.0 + Multi-corpus)
# Indeksleme zamani okunur. Virgulle ayrilmis path listesi (TCK, TCK gerekceleri, CMK, CGTIK, doktrin, vb.)
DATASETS_PATHS=/path/to/tck_rag.json,/path/to/tck_gerekceleri_rag.json,/path/to/cmk_rag.json,/path/to/cgtik_rag.json,/path/to/genelhukumler_rag.json
ONTOLOGY_PATH=/path/to/your/hukuk_sozlugu/ceza_hukuku_ontolojisi.json

# Embedding
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
N_RESULTS=10

# LM Studio (OpenAI uyumlu yerel sunucu)
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_MODEL_NAME=google/gemma-4-e4b

# API
API_HOST=0.0.0.0
API_PORT=8000
